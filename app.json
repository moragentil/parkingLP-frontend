{
  "expo": {
    "name": "parkingLP-frontend",
    "slug": "parkingLP-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyDSXXc-lqWU6vtuR30KDBKZgsZFo_nhrSc"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para detectar si te estás moviendo y recordarte desactivar el estacionamiento.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Para que los recordatorios de estacionamiento funcionen, necesitamos acceder a tu ubicación incluso cuando la app está en segundo plano.",
        "NSMotionUsageDescription": "Usamos los sensores de movimiento para mejorar la detección de velocidad y ahorrar batería."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDSXXc-lqWU6vtuR30KDBKZgsZFo_nhrSc"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.mariansalas.parkingLPfrontend"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "707604f3-e651-42d7-9e4e-590cbd25bd60"
      }
    },
    "owner": "mariansalas"
  }
}
